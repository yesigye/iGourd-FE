# 端口号
VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=/api

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 应用标题
VITE_APP_TITLE=Merchant

# 应用命名空间，用于缓存、store等功能的前缀，确保隔离
VITE_APP_NAMESPACE=merchant-web

# 对store进行加密的密钥，在将store持久化到localStorage时会使用该密钥进行加密
VITE_APP_STORE_SECURE_KEY=please-replace-me-with-your-own-key

VITE_APP_PASSPORT_URL=https://dev-passport.seller100.com

VITE_APP_API_LOGIN_URL=https://dev-passport.seller100.com/login

VITE_APP_PRIVATE_KEY = 

VITE_APP_APP_KEY = MERCHANT_MANAGE_WEB_PC

VITE_APP_API_UPLOAD_URL = https://dev-resource.seller100.com
