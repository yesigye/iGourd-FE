{
  "name": "@igourd-core/design",
  "version": "5.6.1-beta.34",
  "type": "module",
  "scripts": {
    "build": "pnpm vite build",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "exports": {
    "./bem": {
      "development": "./src/scss-bem/bem.scss",
      "default": "./dist/bem.scss"
    },
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/design.css"
    }
  },
  "publishConfig": {
    "registry": "https://packages.aliyun.com/6676817b8549dcfe6e4c1c30/npm/npm-registry/",
    "provenance": false,
    "exports": {
      ".": {
        "default": "./dist/design.css"
      },
      "./bem": {
        "default": "./dist/bem.scss"
      }
    }
  }
}
